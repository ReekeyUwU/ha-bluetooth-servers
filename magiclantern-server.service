[Unit]
Description=Magic Lantern BLE LED strip control server
After=bluetooth.target network.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/led-strip.env
ExecStart=/path/to/venv/bin/python /path/to/magiclantern_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
